# AISync — Turso (hosted libSQL) credentials.
#
# Copy this file to `.streamlit/secrets.toml` (which is git-ignored) to run
# locally against a durable hosted database, or paste these two keys into the
# host's Secrets panel (Streamlit Community Cloud → App → Settings → Secrets).
#
# Leave them unset and AISync falls back to a local SQLite file — fine for a
# demo, but a free host wipes it on restart. See DEPLOY.md for the 3-minute
# Turso setup (free, no card).

TURSO_DATABASE_URL = "libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN   = "paste-your-turso-auth-token-here"
